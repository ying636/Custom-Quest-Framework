<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RimWorldDir>$(MSBuildThisFileDirectory)..\..\..\..\..</RimWorldDir>
    <CQFBuildDir Condition="'$(CQFBuildDir)' == ''">$(MSBuildThisFileDirectory)..\..\..\1.6\Optional\Editor</CQFBuildDir>
    <CQFCoreDir Condition="'$(CQFCoreDir)' == ''">$(MSBuildThisFileDirectory)..\..\..\1.6\Assemblies\net48</CQFCoreDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="QuestEditor_Library"><HintPath>$(CQFCoreDir)\QuestEditor_Library.dll</HintPath></Reference>
    <Reference Include="CQF.Editor"><HintPath>$(CQFBuildDir)\CQF.Editor.dll</HintPath></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(RimWorldDir)\RimWorldWin64_Data\Managed\Assembly-CSharp.dll</HintPath></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(RimWorldDir)\RimWorldWin64_Data\Managed\UnityEngine.CoreModule.dll</HintPath></Reference>
  </ItemGroup>
</Project>
