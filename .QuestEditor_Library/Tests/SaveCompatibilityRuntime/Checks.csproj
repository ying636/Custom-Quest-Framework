<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CQF.CinematicsRuntimeChecks</AssemblyName>
    <DefineConstants Condition="'$(LegacyProducer)' == 'true'">$(DefineConstants);CQF_LEGACY_PRODUCER</DefineConstants>
  </PropertyGroup>
  <Import Project="..\..\RimWorld.props" />
  <ItemGroup>
    <Reference Include="QuestEditor_Library"><HintPath>$(CQFCoreAssembly)</HintPath><Private>false</Private></Reference>
    <Reference Include="CQF.Editor"><HintPath>$(CQFEditorAssembly)</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
