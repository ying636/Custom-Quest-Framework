<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <RimWorldDir Condition="'$(RimWorldDir)' == ''">$(MSBuildThisFileDirectory)..\..\..\..\..</RimWorldDir>
    <CQFAssemblyPath>$(MSBuildThisFileDirectory)..\..\..\1.6\Assemblies\net48\QuestEditor_Library.dll</CQFAssemblyPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="QuestEditor_Library"><HintPath>$(CQFAssemblyPath)</HintPath></Reference>
    <Reference Include="CQF.Editor"><HintPath>$(MSBuildThisFileDirectory)..\..\..\1.6\Optional\Editor\CQF.Editor.dll</HintPath></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(RimWorldDir)\RimWorldWin64_Data\Managed\Assembly-CSharp.dll</HintPath></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(RimWorldDir)\RimWorldWin64_Data\Managed\UnityEngine.CoreModule.dll</HintPath></Reference>
  </ItemGroup>
</Project>
