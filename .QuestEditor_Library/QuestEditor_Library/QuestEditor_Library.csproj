<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <LangVersion>12</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <Import Project="..\RimWorld.props" />

  <PropertyGroup>
    <OutputPath>$(MSBuildThisFileDirectory)..\..\$(RimWorldVersion)\Assemblies\</OutputPath>
  </PropertyGroup>

  <ItemGroup Condition="'$(RimWorldVersion)' != '1.7'">
    <Compile Remove="CompositeMaps\**\*.cs;MapManagement\GameComponent_MapManager.CompositeMaps.cs;MapManagement\GameComponent_MapManager.EntranceTitle.cs" />
  </ItemGroup>

</Project>
