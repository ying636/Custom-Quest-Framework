<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>HCFWithCQF</AssemblyName>
    <LangVersion>12</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>
  <Import Project="..\RimWorld.props" />
  <PropertyGroup>
    <OutputPath>$(MSBuildThisFileDirectory)..\..\$(RimWorldVersion)\Mod\HCF\Assemblies\</OutputPath>
    <HCFFramework Condition="'$(RimWorldVersion)' == '1.7'">net10.0</HCFFramework>
    <HCFFramework Condition="'$(RimWorldVersion)' == '1.6'">net472</HCFFramework>
    <HiveCreatureFrameworkPath Condition="'$(HiveCreatureFrameworkPath)' == ''">$(RimWorldDir)\Mods\巢群生物框架\$(RimWorldVersion)\Assemblies\$(HCFFramework)\HiveCreatureFramework.dll</HiveCreatureFrameworkPath>
    <CustomQuestFrameworkPath Condition="'$(CustomQuestFrameworkPath)' == ''">$(MSBuildThisFileDirectory)..\..\$(RimWorldVersion)\Assemblies\$(TargetFramework)\QuestEditor_Library.dll</CustomQuestFrameworkPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="QuestEditor_Library"><HintPath>$(CustomQuestFrameworkPath)</HintPath><Private>false</Private></Reference>
    <Reference Include="HiveCreatureFramework"><HintPath>$(HiveCreatureFrameworkPath)</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
