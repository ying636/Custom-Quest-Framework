<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <LangVersion>12</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <Import Project="..\RimWorld.props" />
  <PropertyGroup>
    <OutputPath>$(MSBuildThisFileDirectory)..\..\$(RimWorldVersion)\Optional\Domain\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\QuestEditor_Library\QuestEditor_Library.csproj" Private="false" Condition="'$(CoreAssembly)' == ''" />
    <Reference Include="QuestEditor_Library" HintPath="$(CoreAssembly)" Private="false" Condition="'$(CoreAssembly)' != ''" />
    <Content Include="Content\$(RimWorldVersion)\**\*">
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
