<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <LangVersion>12</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <Import Project="..\RimWorld.props" />
  <PropertyGroup>
    <OutputPath>$(MSBuildThisFileDirectory)..\..\$(RimWorldVersion)\Optional\Editor\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\QuestEditor_Library\QuestEditor_Library.csproj" Private="false" />
    <Reference Include="System.Net.Http" Condition="'$(RimWorldVersion)' == '1.6'" />
    <Reference Include="System.Runtime.Serialization" Condition="'$(RimWorldVersion)' == '1.6'" />
  </ItemGroup>
</Project>
