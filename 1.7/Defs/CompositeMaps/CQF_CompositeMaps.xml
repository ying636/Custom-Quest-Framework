<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <WorldObjectDef>
    <defName>CQF_CompositeMapRegion</defName>
    <label>composite map region</label>
    <worldObjectClass>QuestEditor_Library.CQFCompositeMapParent</worldObjectClass>
    <mapGenerator>QE_CustomMap_Editor_Generator</mapGenerator>
    <texture>UI/Null</texture>
    <canBePlayerHome>false</canBePlayerHome>
    <selectable>false</selectable>
    <expandingIcon>false</expandingIcon>
  </WorldObjectDef>
  <ThingDef ParentName="CustomThing_Entrance">
    <defName>CQF_CompositeEntrance</defName>
    <label>passage</label>
    <description>A passage connecting two maps.</description>
    <thingClass>QuestEditor_Library.CustomMapEntrance_Composite</thingClass>
    <category>Building</category>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Standable</passability>
    <selectable>true</selectable>
    <useHitPoints>false</useHitPoints>
    <rotatable>false</rotatable>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>Spawner</texPath>
    </graphicData>
    <building>
      <deconstructible>false</deconstructible>
      <alwaysDeconstructible>false</alwaysDeconstructible>
      <expandHomeArea>false</expandHomeArea>
    </building>
  </ThingDef>
  <ThingDef ParentName="CustomThing_Exit">
    <defName>CQF_CompositeExit</defName>
    <label>passage</label>
    <description>A passage connecting two maps.</description>
    <thingClass>QuestEditor_Library.CustomMapExit</thingClass>
    <category>Building</category>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Standable</passability>
    <selectable>true</selectable>
    <useHitPoints>false</useHitPoints>
    <rotatable>false</rotatable>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>Spawner</texPath>
    </graphicData>
    <building>
      <deconstructible>false</deconstructible>
      <alwaysDeconstructible>false</alwaysDeconstructible>
      <expandHomeArea>false</expandHomeArea>
    </building>
  </ThingDef>
  <GenStepDef>
    <defName>CQF_CompositeMapVisibility</defName>
    <order>10000</order>
    <genStep Class="QuestEditor_Library.GenStep_CompositeMapVisibility" />
  </GenStepDef>
</Defs>
